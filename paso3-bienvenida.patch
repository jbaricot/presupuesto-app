diff --git a/src/components/Onboarding.jsx b/src/components/Onboarding.jsx
new file mode 100644
index 0000000..8e3344e
--- /dev/null
+++ b/src/components/Onboarding.jsx
@@ -0,0 +1,230 @@
+/**
+ * components/Onboarding.jsx
+ * ─────────────────────────────────────────────────────────────────────────
+ * Bienvenida de 3 pasos para un usuario nuevo (sin fila en `budget` y sin
+ * transacciones), para que pueda empezar a registrar en pocos minutos:
+ *   1. Día de pago  → define el ciclo (ver lib/payCycle.js)
+ *   2. Categorías   → ajustar las sugeridas (renombrar tipo, quitar, agregar)
+ *   3. Primer ingreso (opcional)
+ * El día de pago se guarda en `budget` al terminar (o al omitir), y esa
+ * fila es lo que marca al usuario como "ya configurado".
+ *
+ * Props: userId, categories, setCategories, onFinish({ budget, transaction })
+ */
+import React, { useState } from "react";
+import { Wallet, X, Plus, ArrowRight, ArrowLeft, Check, Loader2 } from "lucide-react";
+import { C, FONTS, DEFAULT_BUDGET, TX_TYPE_LABEL } from "../theme.js";
+import { currentPeriod, cyclePeriodLabel, periodForTransaction } from "../lib/payCycle.js";
+import { addCategory, updateCategory, deleteCategory, upsertBudget, addTransaction } from "../lib/data.js";
+import { inputStyle, Btn } from "./ui.jsx";
+
+// Tipos que acepta la base de datos para categorías de gasto
+const CAT_TYPES = ["gastos_esenciales", "gastos_no_esenciales", "credito", "provision"];
+const PAY_DAY_PRESETS = [1, 5, 10, 15, 20, 25];
+const STEPS = ["Día de pago", "Categorías", "Primer ingreso"];
+
+const today = () => new Date().toISOString().slice(0, 10);
+const clampDay = (v) => Math.min(Math.max(parseInt(v, 10) || 1, 1), 28);
+
+export default function Onboarding({ userId, categories, setCategories, onFinish }) {
+  const [step, setStep] = useState(0);
+  const [payDay, setPayDay] = useState(1);
+  const [newCat, setNewCat] = useState({ name: "", type: "gastos_no_esenciales" });
+  const [income, setIncome] = useState({ name: "Salario", value: "", date: today() });
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+
+  const pd = clampDay(payDay);
+
+  // ---------- Categorías ----------
+  const changeType = async (cat, type) => {
+    setError("");
+    try {
+      const updated = await updateCategory(cat.id, { name: cat.name, type });
+      setCategories(categories.map((c) => (c.id === cat.id ? updated : c)));
+    } catch (err) { setError("No se pudo cambiar el tipo: " + err.message); }
+  };
+
+  const removeCat = async (cat) => {
+    setError("");
+    try {
+      await deleteCategory(cat.id);
+      setCategories(categories.filter((c) => c.id !== cat.id));
+    } catch (err) { setError("No se pudo quitar la categoría: " + err.message); }
+  };
+
+  const addCat = async () => {
+    const name = newCat.name.trim();
+    if (!name) return;
+    setError("");
+    try {
+      const created = await addCategory(userId, { name, type: newCat.type });
+      setCategories([...categories, created]);
+      setNewCat({ name: "", type: newCat.type });
+    } catch (err) { setError("No se pudo agregar la categoría: " + err.message); }
+  };
+
+  // ---------- Terminar ----------
+  const finish = async ({ withIncome }) => {
+    setBusy(true);
+    setError("");
+    try {
+      let transaction = null;
+      const value = Number(income.value);
+      if (withIncome && value > 0) {
+        const date = income.date || today();
+        transaction = await addTransaction(userId, {
+          period: periodForTransaction("ingreso", date, pd, []),
+          date,
+          name: income.name.trim() || "Ingreso",
+          type: "ingreso",
+          category: "",
+          payment_method: "Débito",
+          value,
+          paid: true,
+        });
+      }
+      const budget = await upsertBudget(userId, { ...DEFAULT_BUDGET, pay_day: pd });
+      onFinish({ budget, transaction });
+    } catch (err) {
+      setError("No se pudo guardar: " + err.message);
+      setBusy(false);
+    }
+  };
+
+  const groupLabel = (t) => TX_TYPE_LABEL[t] || t;
+  const sortedCats = [...categories].sort((a, b) => (a.type || "").localeCompare(b.type || "") || a.name.localeCompare(b.name));
+
+  return (
+    <div style={{ minHeight: "100vh", display: "flex", alignItems: "center", justifyContent: "center", background: C.paperAlt, fontFamily: "'Inter',sans-serif", padding: 16, boxSizing: "border-box" }}>
+      <style>{FONTS}</style>
+      <div style={{ width: "100%", maxWidth: 520, background: C.card, border: `1px solid ${C.line}`, borderRadius: 12, padding: 28, boxSizing: "border-box" }}>
+        <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 6 }}>
+          <div style={{ width: 34, height: 34, borderRadius: 8, background: C.ink, display: "flex", alignItems: "center", justifyContent: "center" }}>
+            <Wallet size={18} color={C.white} />
+          </div>
+          <div style={{ fontFamily: "'Fraunces',serif", fontSize: 20, fontWeight: 600, color: C.ink }}>Bienvenido a Mi Libro de Cuentas</div>
+        </div>
+        <div style={{ fontSize: 12.5, color: C.inkFaint, marginBottom: 16 }}>
+          Paso {step + 1} de {STEPS.length} · {STEPS[step]}
+        </div>
+        <div style={{ display: "flex", gap: 6, marginBottom: 20 }}>
+          {STEPS.map((s, i) => (
+            <div key={s} style={{ flex: 1, height: 4, borderRadius: 2, background: i <= step ? C.ink : C.line }} />
+          ))}
+        </div>
+
+        {step === 0 && (
+          <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
+            <div style={{ fontSize: 14, color: C.inkSoft, lineHeight: 1.6 }}>
+              Tu mes financiero empieza el día que te pagan, no el 1 del mes. Así tus gastos se miden contra el dinero con el que realmente vives.
+            </div>
+            <div style={{ display: "flex", flexWrap: "wrap", gap: 8 }}>
+              {PAY_DAY_PRESETS.map((d) => (
+                <button key={d} type="button" onClick={() => setPayDay(d)} style={{
+                  padding: "7px 14px", borderRadius: 7, cursor: "pointer", fontSize: 13, fontWeight: 600, fontFamily: "'Inter',sans-serif",
+                  border: `1px solid ${pd === d ? C.ink : C.line}`, background: pd === d ? C.ink : "transparent", color: pd === d ? C.white : C.ink,
+                }}>{d}</button>
+              ))}
+            </div>
+            <label style={{ fontSize: 12.5, fontWeight: 600, color: C.inkSoft }}>
+              Otro día (1 a 28)
+              <input type="number" min="1" max="28" value={payDay} onChange={(e) => setPayDay(e.target.value)}
+                style={{ ...inputStyle, width: 120, marginTop: 6, display: "block", boxSizing: "border-box" }} />
+            </label>
+            <div style={{ fontSize: 12.5, color: C.inkFaint }}>
+              Si te pagan el 29, 30 o 31, elige 28. Tu ciclo actual:{" "}
+              <strong style={{ color: C.inkSoft }}>{cyclePeriodLabel(currentPeriod(pd), pd)}</strong>
+            </div>
+          </div>
+        )}
+
+        {step === 1 && (
+          <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
+            <div style={{ fontSize: 14, color: C.inkSoft, lineHeight: 1.6 }}>
+              Estas son categorías sugeridas. Quita las que no uses, cambia su tipo o agrega las tuyas. Siempre podrás editarlas en la pestaña Categorías.
+            </div>
+            <div style={{ maxHeight: 260, overflowY: "auto", border: `1px solid ${C.line}`, borderRadius: 8 }}>
+              {sortedCats.length === 0 && <div style={{ padding: 12, fontSize: 13, color: C.inkFaint }}>No tienes categorías todavía. Agrega la primera abajo.</div>}
+              {sortedCats.map((c) => (
+                <div key={c.id} style={{ display: "flex", alignItems: "center", gap: 8, padding: "7px 10px", borderBottom: `1px solid ${C.line}` }}>
+                  <div style={{ flex: 1, fontSize: 13.5, color: C.ink }}>{c.name}</div>
+                  <select value={CAT_TYPES.includes(c.type) ? c.type : "gastos_no_esenciales"} onChange={(e) => changeType(c, e.target.value)}
+                    style={{ ...inputStyle, padding: "5px 6px", fontSize: 12 }}>
+                    {CAT_TYPES.map((t) => <option key={t} value={t}>{groupLabel(t)}</option>)}
+                  </select>
+                  <button type="button" onClick={() => removeCat(c)} aria-label={`Quitar ${c.name}`}
+                    style={{ background: "none", border: "none", cursor: "pointer", color: C.inkFaint, display: "flex" }}>
+                    <X size={16} />
+                  </button>
+                </div>
+              ))}
+            </div>
+            <div style={{ display: "flex", gap: 8 }}>
+              <input value={newCat.name} onChange={(e) => setNewCat({ ...newCat, name: e.target.value })} placeholder="Nueva categoría"
+                onKeyDown={(e) => { if (e.key === "Enter") { e.preventDefault(); addCat(); } }}
+                style={{ ...inputStyle, flex: 1, minWidth: 0 }} />
+              <select value={newCat.type} onChange={(e) => setNewCat({ ...newCat, type: e.target.value })} style={{ ...inputStyle, padding: "5px 6px", fontSize: 12 }}>
+                {CAT_TYPES.map((t) => <option key={t} value={t}>{groupLabel(t)}</option>)}
+              </select>
+              <Btn onClick={addCat} disabled={!newCat.name.trim()}><Plus size={14} /></Btn>
+            </div>
+          </div>
+        )}
+
+        {step === 2 && (
+          <div style={{ display: "flex", flexDirection: "column", gap: 12 }}>
+            <div style={{ fontSize: 14, color: C.inkSoft, lineHeight: 1.6 }}>
+              Registra tu último ingreso para ver tu primer ciclo en el Panorama. Puedes omitirlo y hacerlo después desde Transacciones.
+            </div>
+            <label style={{ fontSize: 12.5, fontWeight: 600, color: C.inkSoft }}>
+              Nombre
+              <input value={income.name} onChange={(e) => setIncome({ ...income, name: e.target.value })}
+                style={{ ...inputStyle, width: "100%", marginTop: 6, boxSizing: "border-box" }} />
+            </label>
+            <div style={{ display: "flex", gap: 10 }}>
+              <label style={{ flex: 1, fontSize: 12.5, fontWeight: 600, color: C.inkSoft }}>
+                Valor (COP)
+                <input type="number" min="0" value={income.value} onChange={(e) => setIncome({ ...income, value: e.target.value })} placeholder="0"
+                  style={{ ...inputStyle, width: "100%", marginTop: 6, boxSizing: "border-box" }} />
+              </label>
+              <label style={{ flex: 1, fontSize: 12.5, fontWeight: 600, color: C.inkSoft }}>
+                Fecha
+                <input type="date" value={income.date} onChange={(e) => setIncome({ ...income, date: e.target.value })}
+                  style={{ ...inputStyle, width: "100%", marginTop: 6, boxSizing: "border-box" }} />
+              </label>
+            </div>
+          </div>
+        )}
+
+        {error && <div style={{ fontSize: 12.5, color: C.coral, marginTop: 12 }}>{error}</div>}
+
+        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 22, gap: 8, flexWrap: "wrap" }}>
+          <div>
+            {step > 0 && (
+              <Btn variant="ghost" onClick={() => { setError(""); setStep(step - 1); }} disabled={busy}><ArrowLeft size={14} /> Atrás</Btn>
+            )}
+          </div>
+          <div style={{ display: "flex", gap: 8 }}>
+            {step < 2 && (
+              <>
+                <Btn variant="ghost" onClick={() => finish({ withIncome: false })} disabled={busy}>Omitir configuración</Btn>
+                <Btn onClick={() => { setError(""); setStep(step + 1); }} disabled={busy}>Siguiente <ArrowRight size={14} /></Btn>
+              </>
+            )}
+            {step === 2 && (
+              <>
+                <Btn variant="ghost" onClick={() => finish({ withIncome: false })} disabled={busy}>Omitir</Btn>
+                <Btn onClick={() => finish({ withIncome: true })} disabled={busy || !(Number(income.value) > 0)}>
+                  {busy ? <Loader2 size={14} style={{ animation: "spin 1s linear infinite" }} /> : <Check size={14} />}
+                  {busy ? "Guardando…" : "Empezar"}
+                </Btn>
+              </>
+            )}
+          </div>
+        </div>
+        <style>{`@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}`}</style>
+      </div>
+    </div>
+  );
+}
